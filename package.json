{
	"name": "@natlibfi/fixugen-http-client",
	"description": "Generate unit tests for HTTP clients with fixugen",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://www.npmjs.com/package/@natlibfi/fixugen-http-client",
	"bugs": {
		"url": "https://github.com/natlibfi/fixugen-http-client-js/issues"
	},
	"repository": {
		"url": "https://github.com/NatLibFi/fixugen-http-client-js"
	},
	"license": "MIT",
	"version": "5.0.0-alpha.1",
	"main": "./dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc",
		"lint": "eslint ./src",
		"lint:dev": "eslint --fix ./src",
		"test:base": "node --test --experimental-test-coverage --test-reporter=spec './src/index.test.ts'",
		"test": "npm run lint && npm run test:base",
		"test:dev": "npm run lint:dev && npm run test:base",
		"watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/index.test.ts'",
		"dev": "npm run watch:test",
		"dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
	},
	"dependencies": {
		"@natlibfi/fixugen": "^4.0.0-alpha.1",
		"@natlibfi/fixura": "^5.0.0-alpha.3",
		"debug": "^4.4.3",
		"nock": "^14.0.12"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.2.0",
		"jiti": "^2.6.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.2"
	}
}
